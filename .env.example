# --- Supabase (backend: sessions, sync, media storage, exam state) ----------
# Production: the hosted Supabase project URL + its service_role key (server-only
# secret — set in Vercel Project Settings → Environment Variables, never commit).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local dev only: when SUPABASE_URL points at 127.0.0.1, the dev server derives a
# LAN-facing public base for signed storage URLs automatically. You normally do
# NOT set this in production (there SUPABASE_URL is already public HTTPS).
# SUPABASE_PUBLIC_URL=

# --- App secrets (used by the /api functions) -------------------------------
# Strong random strings in production. VETBARA_SESSION_SECRET signs app sessions;
# VETBARA_SEED_SECRET authorizes POST /api/seed (x-seed-secret header).
VETBARA_SESSION_SECRET=
VETBARA_SEED_SECRET=

# Set to "false" so the backend requires real server-verified sessions (no demo
# fallback). Leave unset/blank only for a no-backend demo build.
VETBARA_DEMO_MODE=false

# --- Translation tooling (optional) -----------------------------------------
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
DEEPL_API_KEY=
